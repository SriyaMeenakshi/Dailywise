# Copy to .env and fill in. Never commit .env.
APP_ENV=development
# Supabase Postgres connection string (use the pooled "Session" string for hosted backends)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Only needed for legacy projects that still sign JWTs with a shared HS256 secret.
# Projects on asymmetric signing keys are verified through the JWKS endpoint instead.
SUPABASE_JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:3000

# Phase 3 (AI) - not used yet
GEMINI_API_KEY=
AI_MODEL=
