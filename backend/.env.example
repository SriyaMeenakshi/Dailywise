# Copy to .env and fill in. Never commit .env.
APP_ENV=development
# Supabase Postgres connection string (use the pooled "Session" string for hosted backends)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Only needed for legacy projects that still sign JWTs with a shared HS256 secret.
# Projects on asymmetric signing keys are verified through the JWKS endpoint instead.
SUPABASE_JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:3000

# ── AI (optional: leave GEMINI_API_KEY empty and everything except AI suggestions still works) ──
# Server-side only. Never put this in a NEXT_PUBLIC_ variable or in the frontend.
GEMINI_API_KEY=
# Economical model for simple extraction (task parsing). Check it exists for your key.
AI_MODEL=gemini-2.5-flash
# Optional stronger model for project breakdown; falls back to AI_MODEL when empty.
AI_MODEL_COMPLEX=
# Per-user daily allowance (UTC day). Cached answers are free and don't count.
AI_DAILY_REQUEST_LIMIT=30
AI_DAILY_TOKEN_LIMIT=200000
AI_MAX_INPUT_CHARS=4000
AI_MAX_OUTPUT_TOKENS=4096
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_CACHE_TTL_DAYS=30
# Estimated cost = tokens x price. Left at 0 so the app never shows invented numbers;
# copy your provider's current USD-per-million-token prices here to enable cost tracking.
AI_PRICE_INPUT_PER_MTOK=0
AI_PRICE_OUTPUT_PER_MTOK=0
